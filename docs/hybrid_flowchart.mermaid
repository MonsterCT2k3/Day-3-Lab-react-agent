graph TD
    A["User Query Received"] --> B{"Does query require<br/>real-time data or<br/>external tools?"}

    B -->|No| C["Knowledge-based<br/>Question?"]
    C -->|Yes| D["ROUTE: CHATBOT BASELINE"]
    C -->|No| E{"Can be answered<br/>from general<br/>knowledge?"}
    E -->|Yes| D
    E -->|No| F["ROUTE: REACT AGENT"]

    B -->|Yes| G{"Single tool<br/>call or<br/>multiple?"}
    G -->|Single| H["Simple lookup<br/>required?"]
    H -->|Yes| I["ROUTE: CHATBOT BASELINE<br/>(with limited tool call)"]
    H -->|No| F

    G -->|Multiple| J{"Requires<br/>reasoning between<br/>steps?"}
    J -->|Yes| F
    J -->|No| I

    D --> K["ChatBot Process"]
    K --> L["Load System Prompt<br/>(Knowledge-only)"]
    L --> M["Call LLM<br/>without tool context"]
    M --> N["Return Natural Answer"]

    F --> O["ReAct Agent Process"]
    O --> P["Initialize ReAct Loop"]
    P --> Q["Step N: Generate<br/>Thought + Action"]
    Q --> R{"Has Final<br/>Answer?"}
    R -->|Yes| S["Extract & Return<br/>Final Answer"]
    R -->|No| T{"Valid Action?"}
    T -->|No| U["Guardrail: Regenerate<br/>or Stop"]
    T -->|Yes| V["Execute Tool"]
    V --> W["Get Observation"]
    W --> X{"Max Iterations<br/>reached?"}
    X -->|Yes| Y["Guardrail: Stop<br/>& Return Best Answer"]
    X -->|No| Q

    I --> Z["Limited Tool Mode"]
    Z --> AA["Chatbot with<br/>single tool access"]
    AA --> N

    U --> Q
    Y --> N
    S --> N
    N --> AB["Output to User"]
